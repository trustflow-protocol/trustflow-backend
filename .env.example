# Accepted values: TESTNET or PUBLIC (Stellar SDK canonical name for mainnet).
# "MAINNET" is also accepted as a legacy alias for "PUBLIC".
# An unrecognized value causes the app to fail fast at startup.
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Multiple endpoints for failover (comma-separated, first is primary)
STELLAR_HORIZON_ENDPOINTS=https://horizon-testnet.stellar.org,https://testnet.stellar.org
SOROBAN_RPC_ENDPOINTS=https://soroban-testnet.stellar.org,https://rpc-testnet.stellar.org
TRUSTFLOW_CONTRACT_ID=
JWT_SECRET=change-me-in-production
PORT=3001
DISCORD_WEBHOOK_URL=

# Runtime environment: development | production | test. Controls CORS wildcard
# rules, Sentry activation, migration-on-startup, and more.
NODE_ENV=development
# Base URL advertised as the "Development" server in the generated Swagger docs.
API_URL=http://localhost:3001
# Comma-separated Stellar public keys (G...) allowed to hit /admin/* endpoints.
ADMIN_ADDRESSES=
# Sentry error reporting DSN. Empty -> Sentry is disabled (no-op).
SENTRY_DSN=

# Abuse detection layered on top of the base rate limiter: an identity that
# trips the limit RATE_LIMIT_ABUSE_THRESHOLD times within
# RATE_LIMIT_ABUSE_WINDOW_SECONDS is locked out for RATE_LIMIT_LOCKOUT_SECONDS.
RATE_LIMIT_ABUSE_WINDOW_SECONDS=300
RATE_LIMIT_ABUSE_THRESHOLD=5
RATE_LIMIT_LOCKOUT_SECONDS=900

# What the rate limiter does when Redis is unreachable (command error or timeout):
#   allow -> fail open: the request proceeds unthrottled (default). Most routes do not
#            otherwise need Redis, so a Redis blip should not take the whole API down.
#   deny  -> fail closed: the request is rejected with 503 + Retry-After.
# This is only the default. Routes override it with @RateLimitOnRedisError('deny') or
# @RateLimit(points, duration, { onRedisError: 'deny' }); /auth/* is fail-closed by
# default so a Redis outage cannot be used to brute-force the login flow.
RATE_LIMIT_ON_REDIS_ERROR=allow

# TTL for stored Idempotency-Key records (see IdempotencyKeyService). Default 24h.
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Escrow reconciliation sweep — re-checks on-chain escrow state against the DB.
# Milliseconds; 0 or negative disables the background sweep. Default 10 minutes.
ESCROW_RECONCILIATION_SWEEP_INTERVAL_MS=600000
# Maximum concurrent chain reads per reconciliation sweep. Default 8.
ESCROW_RECONCILIATION_SWEEP_CONCURRENCY=8

# CORS configuration — required in production when running with credentials: true
# Set to a comma-separated list of allowed origins, e.g., https://app.example.com,https://admin.example.com
# Wildcard '*' is only allowed in development (NODE_ENV != production)
CORS_ORIGIN=http://localhost:3000

# Redis (required for rate limiting, caching, escrow durability, and distributed coordination).
# See docs/runtime-dependencies.md for what degrades when Redis is absent or unreachable.
REDIS_URL=redis://localhost:6379
# Max milliseconds a single Redis command may wait for a reply before it is rejected.
# Keeps a stalled/unreachable Redis from holding requests open for seconds. Default 1000.
REDIS_COMMAND_TIMEOUT_MS=1000

# Core DB (PostgreSQL) — optional. Set DATABASE_URL, or the discrete DB_HOST/DB_NAME
# pair below, to enable the connection pool. Neither set -> pool is unconfigured and
# GET /health reports database: true (not applicable) rather than degraded.
# See docs/runtime-dependencies.md for current usage and future plans.
DATABASE_URL=
# Discrete alternative to DATABASE_URL (ignored when DATABASE_URL is set):
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Set to "true" to connect over TLS. The server certificate is VERIFIED by default.
DB_SSL=false
# PEM CA bundle (inline PEM or a file path) used to verify the server, e.g. the root CA
# downloaded from your managed Postgres provider. Optional client cert/key for mTLS.
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
# Explicit opt-out for local/legacy setups only: "false" skips certificate verification.
# Logged as a warning; refused when NODE_ENV=production.
DB_SSL_REJECT_UNAUTHORIZED=
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Swagger UI (/api/docs) and OpenAPI JSON (/api/docs-json). Defaults to true outside
# production and false in production. When enabled in production, set both SWAGGER_USER and
# SWAGGER_PASSWORD to protect the docs with HTTP basic auth.
SWAGGER_ENABLED=
SWAGGER_USER=
SWAGGER_PASSWORD=

# Run registered schema migrations automatically on backend startup (see MigrationModule).
# Defaults to enabled outside NODE_ENV=test; set to "false" to disable, e.g. when a
# migration should be triggered manually via POST /migrations/:name/run instead.
RUN_MIGRATIONS_ON_STARTUP=true

# IPFS pinning providers (all optional — unconfigured providers run in an
# in-memory simulated mode, so pinning/failover work without any credentials)
PINATA_JWT=
WEB3_STORAGE_TOKEN=
INFURA_IPFS_PROJECT_ID=
INFURA_IPFS_PROJECT_SECRET=
IPFS_REPIN_INTERVAL_MS=300000

# Maximum request body size for JSON payloads (in MB).
# The IPFS pin endpoint accepts base64-encoded content; 15 MB provides headroom
# for a 10 MB decoded deliverable (~13.6 MB base64) plus JSON envelope overhead.
BODY_LIMIT_MB=15

# Webhook outgoing request timeout (ms). Requests that exceed this are aborted
# rather than hanging indefinitely. Defaults to 10 seconds.
WEBHOOK_TIMEOUT_MS=10000

# Gig expiry sweep — marks unanswered gig solicitations expired past their response deadline
GIG_EXPIRY_SWEEP_INTERVAL_MS=300000
# How long a paginated GET /gigs search result page stays cached in Redis
GIG_SEARCH_CACHE_TTL_SECONDS=30

# Transactional outbox relay. Redis is required in production so domain updates
# and durable event rows are committed in the same MULTI/EXEC transaction.
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_LEASE_MS=30000
# Delivered event body retention in Redis. Failed events are retained without TTL.
OUTBOX_DELIVERED_TTL_SECONDS=604800
# Maximum delivery failures before an event becomes terminally failed.
OUTBOX_MAX_ATTEMPTS=5
# Maximum number of serialized payloads retained in the worker queue.
OUTBOX_QUEUE_MAX_LENGTH=1000
